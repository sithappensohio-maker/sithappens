# Sit Happens — Vite/React frontend (multi-stage)
FROM node:20.19-alpine AS builder
WORKDIR /app

# Vite bakes these values into the production bundle. Leave blank for the
# normal single-origin deployment: browser requests use /api and nginx proxies
# them to the backend container. REACT_APP_BACKEND_URL remains accepted by
# vite.config.mjs as a migration fallback for older .env files.
ARG VITE_BACKEND_URL=""
ARG REACT_APP_BACKEND_URL=""
ARG VITE_POS_AGENT_URL=""
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV VITE_POS_AGENT_URL=$VITE_POS_AGENT_URL

RUN corepack enable
COPY frontend/package.json ./
RUN yarn install --network-timeout 600000

COPY frontend/ ./
RUN yarn build

FROM nginx:alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
