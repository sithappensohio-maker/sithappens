+async def _decorate_service_package_schedule(items: List[Dict[str, Any]]) -> None:
+    """Attach read-only Board & Train scheduling metadata to service rows.
+
+    Linked Program Studio records are authoritative. A narrow compatibility
+    path also decorates old explicit-duration Board & Train services that
+    predate ``package_program_id`` so Quick Check-In can show the correct stay
+    immediately after upgrade.
+    """
+    program_ids = sorted({
+        str(row.get("package_program_id"))
+        for row in (items or [])
+        if row.get("package_program_id")
+    })
+    programs = []
+    if program_ids:
+        programs = await db.programs.find(
+            {"id": {"$in": program_ids}},
+            {"_id": 0, "id": 1, "name": 1, "type": 1, "format": 1, "estimated_weeks": 1},
+        ).to_list(len(program_ids))
+    by_id = {p.get("id"): p for p in programs}
+    for row in items:
+        days = None
+        program = by_id.get(row.get("package_program_id"))
+        if program and program.get("type") == "board_train":
+            days = _program_residential_duration_days(program)
+            row["package_program_type"] = "board_train"
+            row["package_program_name"] = program.get("name") or "Board & Train"
+        elif not row.get("package_program_id"):
+            days = _legacy_board_train_service_duration_days(row)
+            if days:
+                row["package_program_type"] = "board_train"
+                row["package_program_name"] = row.get("name") or "Board & Train"
+                row["package_schedule_source"] = "legacy_service_duration"
+        if not days:
+            continue
+        row["residential_training"] = True
+        row["package_duration_days"] = days
+        if days % 7 == 0:
+            weeks = days // 7
+            row["package_duration_label"] = f"{weeks} week" + ("s" if weeks != 1 else "")
+        else:
+            row["package_duration_label"] = f"{days} days"
+
+
