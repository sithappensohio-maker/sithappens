         {["in_person","hybrid"].includes(currentDelivery) && data.enrollment?.status==="active" && currentLesson?.checkpoint?.enabled && <section className="rounded-2xl border border-shPrimary/30 bg-shPrimary/[0.03] p-4"><div className="flex items-start justify-between gap-3"><div><h3 className="font-black text-shText">Live trainer checkpoint · {currentLesson.name}</h3><p className="text-[11px] text-shTextMuted mt-1">Score the same School rubric while you observe the dog in person. No client video is required; this writes to the normal checkpoint history and progression engine.</p></div><span className="text-[9px] font-black uppercase tracking-widest text-shPrimary shrink-0">{deliveryLabel(currentDelivery)}</span></div><div className="grid lg:grid-cols-2 gap-4 mt-4"><div><p className="text-[10px] font-black uppercase tracking-widest text-shTextMuted mb-2">Handler skills</p><div className="space-y-2">{(currentLesson.checkpoint.handler_criteria||[]).map(c=><label key={c.id} className="grid grid-cols-[1fr_88px] items-center gap-2 rounded-xl bg-black/15 p-2.5"><span className="text-xs text-shText">{c.label||c.name||c.id}</span><select className="input-school" value={liveCheckpoint.handler_scores[c.id]||3} onChange={e=>setLiveCheckpoint(x=>({...x,handler_scores:{...x.handler_scores,[c.id]:Number(e.target.value)}}))}>{[1,2,3,4,5].map(v=><option key={v} value={v}>{v}/5</option>)}</select></label>)}</div></div><div><p className="text-[10px] font-black uppercase tracking-widest text-shTextMuted mb-2">Dog performance</p><div className="space-y-2">{(currentLesson.checkpoint.dog_criteria||[]).map(c=><label key={c.id} className="grid grid-cols-[1fr_88px] items-center gap-2 rounded-xl bg-black/15 p-2.5"><span className="text-xs text-shText">{c.label||c.name||c.id}</span><select className="input-school" value={liveCheckpoint.dog_scores[c.id]||3} onChange={e=>setLiveCheckpoint(x=>({...x,dog_scores:{...x.dog_scores,[c.id]:Number(e.target.value)}}))}>{[1,2,3,4,5].map(v=><option key={v} value={v}>{v}/5</option>)}</select></label>)}</div></div></div><div className="grid sm:grid-cols-[220px_1fr_auto] gap-2 mt-3 items-end"><Field label="Result"><select className="input-school" value={liveCheckpoint.outcome} onChange={e=>setLiveCheckpoint(x=>({...x,outcome:e.target.value}))}><option value="advance">Pass · Advance</option><option value="prescribe_practice">Needs More Practice</option><option value="trainer_assist_recommended">Trainer Assist</option></select></Field><Field label="Trainer feedback"><textarea className="input-school min-h-[64px]" value={liveCheckpoint.feedback} onChange={e=>setLiveCheckpoint(x=>({...x,feedback:e.target.value}))} placeholder="What went well and what to work on next…"/></Field><button disabled={saving} onClick={recordLiveCheckpoint} className="min-h-[42px] px-4 rounded-xl bg-shPrimary text-bgHeader text-xs font-black uppercase tracking-widest">Record Checkpoint</button></div></section>}
